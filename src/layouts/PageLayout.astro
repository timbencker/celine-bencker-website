---
import { LOCALES } from '../i18n/config';
import { backgroundPageFor, findCounterpart, pageHref, type ResolvedPage } from '../i18n/pages';
import type { Alternate } from './BaseLayout.astro';
import SiteChrome from './SiteChrome.astro';

/**
 * Chrome for a content page: derives title, hreflang alternates, canonical
 * URL, language counterpart and background from the page's entry, then hands
 * everything to SiteChrome.
 */
interface Props {
  page: ResolvedPage;
  allPages: ResolvedPage[];
}

const { page, allPages } = Astro.props;
const { locale, entry } = page;

const counterpart = findCounterpart(page, allPages);
const absolute = (p: ResolvedPage) => new URL(pageHref(p), Astro.site).href;

const alternates: Alternate[] = LOCALES.flatMap((l) => {
  const match = l === locale ? page : counterpart?.locale === l ? counterpart : null;
  return match ? [{ locale: l, href: absolute(match) }] : [];
});
---

<SiteChrome
  locale={locale}
  title={entry.data.title}
  description={entry.data.description}
  currentHref={pageHref(page)}
  counterpartHref={counterpart ? pageHref(counterpart) : null}
  background={entry.data.background}
  backgroundHue={entry.data.backgroundHue}
  backgroundPage={backgroundPageFor(page.translationKey)}
  alternates={alternates}
  canonical={absolute(page)}
>
  <slot name="masthead" slot="masthead" />
  <slot />
</SiteChrome>
