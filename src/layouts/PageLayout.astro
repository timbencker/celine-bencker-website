---
import BaseLayout, { type Alternate } from './BaseLayout.astro';
import LanguageSwitcher from '../components/LanguageSwitcher.astro';
import { LOCALES } from '../i18n/config';
import { findCounterpart, navigationFor, pageHref, type ResolvedPage } from '../i18n/pages';
import { t } from '../i18n/ui';

/**
 * Page chrome — header, navigation, language switcher, footer — defined once
 * and shared by every route in both languages.
 */
interface Props {
  page: ResolvedPage;
  allPages: ResolvedPage[];
}

const { page, allPages } = Astro.props;
const { locale, entry } = page;

const nav = await navigationFor(locale, allPages);
const counterpart = findCounterpart(page, allPages);

const absolute = (p: ResolvedPage) => new URL(pageHref(p), Astro.site).href;

const alternates: Alternate[] = LOCALES.flatMap((l) => {
  const match = l === locale ? page : counterpart?.locale === l ? counterpart : null;
  return match ? [{ locale: l, href: absolute(match) }] : [];
});

const currentPath = pageHref(page);
---

<BaseLayout
  locale={locale}
  title={entry.data.title}
  description={entry.data.description}
  background={entry.data.background}
  alternates={alternates}
  canonical={absolute(page)}
>
  <header class="site-header">
    <nav aria-label={t(locale, 'nav.primary')}>
      <ul class="site-nav">
        {nav.map((item) => {
          const href = pageHref(item);
          const isCurrent = href === currentPath;
          return (
            <li>
              <a href={href} aria-current={isCurrent ? 'page' : undefined}>
                {item.entry.data.title}
              </a>
            </li>
          );
        })}
      </ul>
    </nav>
    <LanguageSwitcher current={page} counterpart={counterpart} />
  </header>

  <main id="main">
    <slot />
  </main>

  <footer aria-label={t(locale, 'footer.label')}>
    <slot name="footer" />
  </footer>
</BaseLayout>

<style>
  .site-header,
  main,
  footer {
    max-width: var(--measure);
    margin-inline: auto;
    padding-inline: var(--space-3);
  }

  .site-header {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    align-items: baseline;
    justify-content: space-between;
    padding-block: var(--space-4);
  }

  .site-nav {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* Current page marked by more than colour. */
  .site-nav a[aria-current='page'] {
    font-weight: 700;
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
  }

  footer {
    padding-block: var(--space-5);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }
</style>
