---
import SiteFooter from '../components/primitives/SiteFooter.astro';
import SiteNav from '../components/primitives/SiteNav.astro';
import { LOCALES } from '../i18n/config';
import {
  backgroundPageFor,
  findCounterpart,
  homeHref,
  navigationFor,
  pageHref,
  resolvePage,
  type ResolvedPage,
} from '../i18n/pages';
import { getSite } from '../lib/site';
import BaseLayout, { type Alternate } from './BaseLayout.astro';

/**
 * Page chrome — defined once and shared by every route in both languages, so
 * the German and English versions cannot drift apart.
 *
 * The header sits on paper with a hairline below, as on all seven boards, and
 * holds the navigation plus a `masthead` slot for the page's own title block.
 * Sections below the header manage their own width, so full-width surfaces
 * (the Home band, bone sections) can reach the edges.
 */
interface Props {
  page: ResolvedPage;
  allPages: ResolvedPage[];
}

const { page, allPages } = Astro.props;
const { locale, entry } = page;

const site = await getSite();
const nav = await navigationFor(locale, allPages);
const counterpart = findCounterpart(page, allPages);
const imprintHref = `${pageHref(resolvePage('contact', locale, allPages))}#impressum`;

const absolute = (p: ResolvedPage) => new URL(pageHref(p), Astro.site).href;

const alternates: Alternate[] = LOCALES.flatMap((l) => {
  const match = l === locale ? page : counterpart?.locale === l ? counterpart : null;
  return match ? [{ locale: l, href: absolute(match) }] : [];
});
---

<BaseLayout
  locale={locale}
  title={entry.data.title}
  description={entry.data.description}
  background={entry.data.background}
  backgroundHue={entry.data.backgroundHue}
  backgroundPage={backgroundPageFor(page.translationKey)}
  alternates={alternates}
  canonical={absolute(page)}
>
  <header class="relative border-b border-line">
    <SiteNav
      locale={locale}
      current={page}
      nav={nav}
      counterpart={counterpart}
      homeHref={homeHref(locale)}
      tagline={site.tagline[locale]}
    />
    <slot name="masthead" />
  </header>

  {/* tabindex lets the skip link move focus here; main itself is not interactive. */}
  <main id="main" tabindex="-1" class="focus-visible:outline-none">
    <slot />
  </main>

  <SiteFooter locale={locale} imprintHref={imprintHref} />
</BaseLayout>
