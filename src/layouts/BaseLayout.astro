---
import '../styles/global.css';

import Background, { type BackgroundVariant } from '../components/background/Background.astro';
import { DEFAULT_LOCALE, LOCALE_HTML_LANG, type Locale } from '../i18n/config';
import { t } from '../i18n/ui';
import { withBase } from '../i18n/urls';

/**
 * The document shell: one definition, shared by both languages, so the two
 * versions cannot drift apart. Everything language-specific arrives as props.
 */
export interface Alternate {
  locale: Locale;
  /** Absolute URL — hreflang annotations must not be relative. */
  href: string;
}

interface Props {
  locale: Locale;
  title: string;
  description: string;
  background?: BackgroundVariant;
  alternates?: Alternate[];
  canonical?: string;
}

const { locale, title, description, background = 'aus', alternates = [], canonical } = Astro.props;

const xDefault = alternates.find((a) => a.locale === DEFAULT_LOCALE);
---

<!doctype html>
<html lang={LOCALE_HTML_LANG[locale]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}

    {/* Reciprocal hreflang pairs, plus x-default pointing at the German version. */}
    {alternates.map((alt) => (
      <link rel="alternate" hreflang={LOCALE_HTML_LANG[alt.locale]} href={alt.href} />
    ))}
    {xDefault && <link rel="alternate" hreflang="x-default" href={xDefault.href} />}

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}

    <link rel="sitemap" href={withBase('sitemap.xml')} />
    <slot name="head" />
  </head>

  <body>
    <a class="skip-link" href="#main">
      {t(locale, 'skip.toContent')}
    </a>
    <Background variant={background} />
    <slot />
  </body>
</html>

<style>
  /*
   * Off-screen until focused, then clearly visible. The first thing a keyboard
   * user meets on every page.
   */
  .skip-link {
    position: absolute;
    left: var(--space-2);
    top: var(--space-2);
    z-index: 100;
    padding: var(--space-2) var(--space-3);
    background: var(--color-accent);
    color: var(--color-accent-contrast);
    border-radius: var(--radius);
    transform: translateY(-200%);
  }

  .skip-link:focus-visible {
    transform: translateY(0);
  }
</style>
