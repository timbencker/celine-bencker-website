---
import '../styles/global.css';

import { Font } from 'astro:assets';

import Background, {
  type BackgroundHue,
  type BackgroundPage,
  type BackgroundVariant,
} from '../components/background/Background.astro';
import { DEFAULT_LOCALE, LOCALE_HTML_LANG, type Locale } from '../i18n/config';
import { t } from '../i18n/ui';
import { withBase } from '../i18n/urls';

/**
 * The document shell: one definition, shared by both languages, so the two
 * versions cannot drift apart. Everything language-specific arrives as props.
 *
 * The browser title and `og:title` read "<page title> · <site name>", e.g.
 * "Forschung · Celine Bencker", so a tab or a shared link names whose page it
 * is. A page whose title already is the site name (Home) keeps it as it is.
 */
export interface Alternate {
  locale: Locale;
  /** Absolute URL — hreflang annotations must not be relative. */
  href: string;
}

interface Props {
  locale: Locale;
  /** The page's own title; the site name is added here. */
  title: string;
  /** `siteName` from src/content/data/site/site.yaml. */
  siteName: string;
  description: string;
  background?: BackgroundVariant;
  backgroundHue?: BackgroundHue;
  backgroundPage?: BackgroundPage;
  alternates?: Alternate[];
  canonical?: string;
  /** e.g. `noindex` for the 404 page. */
  robots?: string;
  /** The serif style this page shows, so its file is preloaded. */
  serif?: 'normal' | 'italic';
}

const {
  locale,
  title,
  siteName,
  description,
  background = 'aus',
  backgroundHue = 'gelb',
  backgroundPage = 'home',
  alternates = [],
  canonical,
  robots,
  serif,
} = Astro.props;

const documentTitle = title === siteName ? title : `${title} · ${siteName}`;
const xDefault = alternates.find((a) => a.locale === DEFAULT_LOCALE);
---

<!doctype html>
<html lang={LOCALE_HTML_LANG[locale]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    {/*
      Preloaded: the Latin files a page renders first. Otherwise the browser
      finds a font only once it lays out text that uses it, which Lighthouse
      reports as a request chain. Latin covers German and English; Latin
      Extended loads when a page needs it.
    */}
    <Font cssVariable="--font-manrope" preload={[{ subset: 'latin' }]} />
    <Font
      cssVariable="--font-instrument-serif"
      preload={serif ? [{ subset: 'latin', style: serif }] : false}
    />

    <title>{documentTitle}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    {robots && <meta name="robots" content={robots} />}
    {/* Declared explicitly: without it browsers ask for /favicon.ico at the
        host root, which is outside the base path. */}
    <link rel="icon" type="image/svg+xml" href={withBase('favicon.svg')} />

    {/* Reciprocal hreflang pairs, plus x-default pointing at the German version. */}
    {alternates.map((alt) => (
      <link rel="alternate" hreflang={LOCALE_HTML_LANG[alt.locale]} href={alt.href} />
    ))}
    {xDefault && <link rel="alternate" hreflang="x-default" href={xDefault.href} />}

    <meta property="og:type" content="website" />
    <meta property="og:title" content={documentTitle} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}

    <link rel="sitemap" href={withBase('sitemap.xml')} />
    <slot name="head" />
  </head>

  <body>
    <a class="skip-link" href="#main">
      {t(locale, 'skip.toContent')}
    </a>
    <Background variant={background} hue={backgroundHue} page={backgroundPage} />
    <slot />

    <script>
      /*
       * Remembers an explicit language choice. This is the ONLY place
       * JavaScript touches routing, it is written here and read only on `/`,
       * and it never infers from navigator.language — a shared link always
       * opens in the language its URL names. See docs/i18n-policy.md.
       */
      document.querySelectorAll<HTMLAnchorElement>('[data-language-choice]').forEach((link) => {
        link.addEventListener('click', () => {
          try {
            localStorage.setItem('preferred-locale', link.dataset.languageChoice ?? '');
          } catch {
            /* Storage unavailable (private mode) — the link still works. */
          }
        });
      });
    </script>
  </body>
</html>
