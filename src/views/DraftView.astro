---
import { render } from 'astro:content';

import Section from '../components/primitives/Section.astro';
import type { ResolvedPage } from '../i18n/pages';
import PageLayout from '../layouts/PageLayout.astro';
import { cn } from '../lib/cn';
import { container } from '../lib/styles';

/**
 * Stand-in for pages whose board is not built yet: the page title and its
 * Markdown body inside the real chrome. Each page moves to its own view as it
 * is implemented, so this should shrink to nothing.
 *
 * The default slot renders after the body — stubs use it to keep link
 * targets that other pages already point at.
 */
interface Props {
  page: ResolvedPage;
  allPages: ResolvedPage[];
}

const { page, allPages } = Astro.props;
const { Content } = await render(page.entry);
---

<PageLayout page={page} allPages={allPages}>
  <div slot="masthead" class={cn(container, 'pb-10 pt-10 md:pb-[72px] md:pt-16')}>
    <h1 class="max-w-[16ch] text-[48px] font-bold leading-[0.98] tracking-[-0.045em] text-balance md:text-[72px]">
      {page.entry.data.title}
    </h1>
  </div>

  <Section layout="stacked">
    <div class="max-w-[64ch] text-[16px] leading-[1.5] md:text-body">
      <Content />
      <slot />
    </div>
  </Section>
</PageLayout>
