---
import { getCollection } from 'astro:content';

import Band from '../components/primitives/Band.astro';
import ListRow from '../components/primitives/ListRow.astro';
import Portrait from '../components/primitives/Portrait.astro';
import Section from '../components/primitives/Section.astro';
import TextLink from '../components/primitives/TextLink.astro';
import Tile from '../components/primitives/Tile.astro';
import { pageHref, resolvePage, type ResolvedPage } from '../i18n/pages';
import PageLayout from '../layouts/PageLayout.astro';
import { cn } from '../lib/cn';
import { container, heading } from '../lib/styles';

/**
 * Home — board 6a, "Reduziert – alles, was nicht trägt, ist weg".
 * Who: every audience, mostly arriving from search or a shared link.
 * Job: topic and affiliation in three seconds, then onward.
 *
 * Header with the one serif word and the portrait, the lilac band the portrait
 * tucks behind, the research lines, and two exits. Nothing else.
 */
interface Props {
  page: ResolvedPage;
  allPages: ResolvedPage[];
}

const { page, allPages } = Astro.props;
const { locale } = page;
const { hero, home } = page.entry.data;

if (!hero || !home) {
  throw new Error(
    `src/content/pages/${page.entry.id}.md needs both \`hero\` and \`home\` in its frontmatter.`,
  );
}

const hrefFor = (to: string) => pageHref(resolvePage(to, locale, allPages));
const researchHref = hrefFor('research');
const research = (await getCollection('research')).sort((a, b) => a.data.order - b.data.order);

const lastLine = hero.lines.length - 1;

/**
 * From tablet on the title's lines never wrap, so each must fit its column:
 * the full page width on a tablet, the 7/12 column on desktop. There the gap
 * beside it holds the background's hero marks, and a line running into the
 * gap would put a mark under text. The size follows the column (container
 * query units) and the longest line, and never exceeds the spec's 88px.
 *
 * HEADING_FIT is the column share one character takes at this weight and
 * tracking (cqi × characters), measured in the browser with a margin — so a
 * heading Celine edits keeps fitting. Being a share of the column, it holds
 * at any column width. A line may reach GAP_ALLOWANCE past the column, as the
 * board's own 1280px title does: on desktop into the 80px gap, where the hero
 * marks start at least 24px in, so 8px stay clear; on a tablet into the 48px
 * page margin, which has no marks. Measured: German 88px at 1280, English
 * 82px. From the formula: at 768 (672px column) German 88px, English 86px; at
 * 1120 (551px column) German 75px, English 70px.
 */
const HEADING_FIT = 200;
const GAP_ALLOWANCE = '16px';
const longest = Math.max(
  ...hero.lines.map(
    (line, i) => line.length + (i === lastLine && hero.emphasis ? hero.emphasis.length + 1 : 0),
  ),
);
const headingFit = `--heading-fit: calc((100cqi + ${GAP_ALLOWANCE}) * ${(HEADING_FIT / longest / 100).toFixed(4)})`;
---

<PageLayout page={page} allPages={allPages} serif={hero.emphasis ? 'italic' : undefined}>
  <div
    slot="masthead"
    class={cn(
      container,
      'grid gap-5 pt-10 tablet:pt-24 desktop:grid-cols-[minmax(0,7fr)_minmax(0,5fr)] desktop:items-end desktop:gap-20',
    )}
  >
    <div class="@container flex flex-col gap-5 tablet:gap-9 desktop:pb-16">
      <h1
        style={headingFit}
        class="text-[52px] font-bold leading-[0.98] tracking-[-0.04em] text-balance tablet:text-[length:min(88px,var(--heading-fit))] tablet:leading-[0.94] tablet:tracking-[-0.05em]"
      >
        {hero.lines.map((line, i) => (
          <>
            {i > 0 && <br class="hidden tablet:inline" />}
            {i > 0 && ' '}
            <span class="tablet:whitespace-nowrap">
              {line}
              {i === lastLine && hero.emphasis && (
                <>
                  {' '}
                  <span class="font-serif font-normal italic tracking-[-0.02em] text-lilac-text">
                    {hero.emphasis}
                  </span>
                </>
              )}
            </span>
          </>
        ))}
      </h1>

      {hero.lead && (
        <p class="max-w-[36ch] text-[17px] leading-[1.5] text-text-2 tablet:text-lead">
          {hero.lead}
        </p>
      )}

      {/* One line from tablet on, like the title lines; the narrowest column is 551px (1120). */}
      <ul
        role="list"
        class="flex flex-wrap gap-x-6 gap-y-2.5 text-[16px] tablet:flex-nowrap tablet:gap-7 tablet:text-[17px]"
      >
        {home.links.map((link) => (
          <li>
            <TextLink href={hrefFor(link.to)}>{link.label}</TextLink>
          </li>
        ))}
      </ul>
    </div>

    {/*
      Tucks behind the band: 72px on phones, 48px from tablet. Stacked, it is
      70% wide, at most 420px (about its desktop size), and sits 8px further
      from the links; beside the text, it takes 86% of its column.
    */}
    <div class="relative z-[2] -mb-[72px] mt-2 w-[70%] rounded-image tablet:max-w-[420px] shadow-[0_24px_48px_-28px_rgb(0_0_0/0.25)] tablet:-mb-12 tablet:shadow-[0_30px_60px_-30px_rgb(0_0_0/0.25)] desktop:ml-auto desktop:mt-0 desktop:w-[86%]">
      <Portrait locale={locale} />
    </div>
  </div>

  <Band locale={locale} />

  <Section
    labelledby="home-research"
    space="none"
    class="pb-12 pt-24 tablet:pb-32 tablet:pt-[184px]"
  >
    <h2 id="home-research" class={heading({ level: 'section' })}>
      {home.researchHeading}
    </h2>
    <ul role="list" class="flex flex-col">
      {research.map((line) => (
        <li>
          <ListRow
            href={`${researchHref}#${line.data.id}`}
            title={line.data.title[locale]}
            sub={line.data.teaser[locale]}
          />
        </li>
      ))}
    </ul>
  </Section>

  <Section layout="stacked" space="none" class="pb-16 tablet:pb-24">
    <ul role="list" class="grid gap-3 desktop:grid-cols-2 desktop:gap-6">
      {home.exits.map((exit) => (
        <li>
          <Tile href={hrefFor(exit.to)} title={exit.title} meta={exit.meta} />
        </li>
      ))}
    </ul>
  </Section>
</PageLayout>
