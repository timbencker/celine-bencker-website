---
import { getCollection } from 'astro:content';

import Button from '../components/primitives/Button.astro';
import MailLink from '../components/primitives/MailLink.astro';
import PageHeader from '../components/primitives/PageHeader.astro';
import PageTitle from '../components/primitives/PageTitle.astro';
import Section from '../components/primitives/Section.astro';
import Tile from '../components/primitives/Tile.astro';
import { compareDates, describeDate, isUpcoming } from '../components/talks-media/partialDate';
import { findPublicFile } from '../components/talks-media/publicFile';
import QuoteBlock from '../components/talks-media/QuoteBlock.astro';
import TalkRow from '../components/talks-media/TalkRow.astro';
import type { ResolvedPage } from '../i18n/pages';
import PageLayout from '../layouts/PageLayout.astro';
import { cn } from '../lib/cn';
import { getSite } from '../lib/site';
import { heading } from '../lib/styles';

/**
 * Talks & Media — board 8c, "Für Redaktionen gebaut".
 * Who: editors and event organisers.
 * Job: topics, tone and availability in ten seconds; then a mail.
 *
 * Header with the one-line bio and the themes as questions, the quote block,
 * the talks, the media pieces, and "Für Redaktionen" — the site's one
 * lilac-tint section — with the press kit and the address. The "Alle Talks" /
 * "Alle Beiträge" links on the board have no target and are left out.
 *
 * Upcoming vs past is decided at build time, so a talk moves to the past list
 * with the first build after its date.
 */
interface Props {
  page: ResolvedPage;
  allPages: ResolvedPage[];
}

const { page, allPages } = Astro.props;
const { locale } = page;
const { hero, talksMedia: copy } = page.entry.data;

if (!hero?.lead || !copy) {
  throw new Error(
    `src/content/pages/${page.entry.id}.md needs \`hero\` (with \`lead\`) and \`talksMedia\` in its frontmatter.`,
  );
}

const { email } = await getSite();
if (!email) {
  throw new Error(
    'Talks & Media offers the address in site.yaml for press enquiries; set `email`.',
  );
}

// --- Talks: upcoming soonest first, past latest first ---------------------
const today = new Date();
const talks = await getCollection('talks');
const upcoming = talks
  .filter((talk) => isUpcoming(talk.data.date, today))
  .sort((a, b) => compareDates(a.data.date, b.data.date));
const past = talks
  .filter((talk) => !isUpcoming(talk.data.date, today))
  .sort((a, b) => compareDates(b.data.date, a.data.date));

const talkMeta = ({ venue, location, format }: (typeof talks)[number]['data']) => [
  location ? `${venue} · ${location}` : venue,
  copy.talks.formats[format],
];

const talkLists = [
  { id: 'talks-upcoming', heading: copy.talks.upcomingHeading, items: upcoming },
  { id: 'talks-past', heading: copy.talks.pastHeading, items: past },
].filter((list) => list.items.length > 0);

// --- Media: latest first; at most one carries the quote -------------------
const media = (await getCollection('media')).sort((a, b) => compareDates(b.data.date, a.data.date));
const quoted = media.filter((piece) => piece.data.quote);
if (quoted.length > 1) {
  throw new Error(
    `src/content/data/media.yaml: only one piece may carry a quote, found ${quoted.length} (${quoted
      .map((piece) => piece.id)
      .join(', ')}).`,
  );
}
const featured = quoted[0]?.data;
const quote = featured?.quote && {
  text: featured.quote.text,
  lang: featured.quote.lang,
  source: `${featured.outlet} · ${describeDate(featured.date, locale).long}`,
  audio: featured.quote.audio,
};

// --- Press kit: only once the file exists, with its real size -------------
const kit = copy.press.kit;
const kitFile = kit ? findPublicFile(kit.file) : null;
const pressIntro = kit && kitFile ? `${copy.press.intro} ${kit.contents}` : copy.press.intro;
---

<PageLayout page={page} allPages={allPages}>
  <PageHeader slot="masthead" ratio="6/6">
    <PageTitle class="md:gap-8">
      {hero.lines.map((line, i) => (
        <>
          {i > 0 && <br class="hidden md:inline" />}
          {i > 0 && ' '}
          {line}
        </>
      ))}
      <span slot="intro" class="block max-w-[34ch]">
        {hero.lead}
      </span>
    </PageTitle>
    <ul
      slot="aside"
      role="list"
      aria-label={copy.themes.label}
      class="flex w-full flex-col gap-3 pt-2 text-[18px] font-semibold leading-[1.3] tracking-[-0.02em] md:gap-[18px] md:pb-1.5 md:pt-0 md:text-left md:text-[22px]"
    >
      {copy.themes.items.map((question) => (
        <li class="text-balance">{question}</li>
      ))}
    </ul>
  </PageHeader>

  <QuoteBlock
    locale={locale}
    quote={quote}
    placeholder={copy.quote.placeholder}
    photoLabel={copy.quote.photo}
    listenLabel={copy.quote.listen}
  />

  {talkLists.length > 0 && (
    <div class="bg-bone-soft">
      {talkLists.map((list, i) => (
        <Section
          labelledby={list.id}
          layout="stacked"
          space="none"
          class={cn('pb-14 md:pb-24', i === 0 && 'pt-14 md:pt-24')}
        >
          <h2 id={list.id} class={cn(heading({ level: 'section' }), 'pb-6 md:pb-7')}>
            {list.heading}
          </h2>
          <ul role="list" class="flex flex-col">
            {list.items.map((talk) => (
              <li>
                <TalkRow
                  locale={locale}
                  date={talk.data.date}
                  title={talk.data.title}
                  titleLang={talk.data.lang}
                  meta={talkMeta(talk.data)}
                  href={talk.data.url}
                />
              </li>
            ))}
          </ul>
        </Section>
      ))}
    </div>
  )}

  {(media.length > 0 || copy.media.placeholder) && (
    <Section labelledby="media" layout="stacked" space="compact">
      <h2 id="media" class={cn(heading({ level: 'section' }), 'pb-6 md:pb-9')}>
        {copy.media.heading}
      </h2>
      {media.length > 0 ? (
        <ul role="list" class="grid gap-3 md:grid-cols-3 md:gap-5">
          {media.map((piece) => (
            <li>
              <Tile
                kind="card"
                logo
                href={piece.data.url}
                locale={locale}
                title={piece.data.title}
                meta={[
                  piece.data.outlet,
                  copy.media.formats[piece.data.format],
                  describeDate(piece.data.date, locale).short,
                ].join(' · ')}
              />
            </li>
          ))}
        </ul>
      ) : (
        <p class="text-[16px] leading-[1.5] text-text-2 md:text-body">{copy.media.placeholder}</p>
      )}
    </Section>
  )}

  <Section labelledby="press" surface="lilac" layout="stacked" space="compact">
    <div class="grid gap-6 md:grid-cols-[minmax(0,7fr)_minmax(0,5fr)] md:items-center md:gap-16">
      <div class="flex flex-col gap-6 md:gap-[18px]">
        <h2 id="press" class={heading({ level: 'section' })}>
          {copy.press.heading}
        </h2>
        <p class="text-[17px] leading-[1.5] text-text-2 md:max-w-[44ch] md:text-lead-sm">
          {pressIntro}
        </p>
        {copy.press.note && (
          <p class="text-[14px] leading-[1.5] text-text-2 md:text-meta">{copy.press.note}</p>
        )}
      </div>
      {/* 20px, not the board's 28: the real address is longer than the board's and would wrap. */}
      <div class="flex flex-col items-start gap-3.5 md:flex-row md:flex-wrap md:items-center md:justify-end md:gap-x-5 md:gap-y-3">
        {kit && kitFile && (
          <Button
            tone="ink"
            href={kitFile.href}
            locale={locale}
            download={{ format: kitFile.format, bytes: kitFile.bytes }}
          >
            {kit.label}
          </Button>
        )}
        <MailLink
          email={email}
          class="inline-flex min-h-[44px] items-center text-[16px] font-semibold text-sage transition-colors hover:text-ink md:text-[17px]"
        />
      </div>
    </div>
  </Section>
</PageLayout>
