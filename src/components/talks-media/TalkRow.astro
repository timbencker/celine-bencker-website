---
import type { Locale } from '../../i18n/config';
import { t } from '../../i18n/ui';
import { cn } from '../../lib/cn';
import { arrow, EXTERNAL_GLYPH } from '../../lib/styles';
import { linkKind } from '../primitives/links';
import { describeDate, type PartialDate } from './partialDate';

/**
 * One talk: ListRow `date`, for dates only as precise as their source.
 *
 * ListRow's `date` row needs a full calendar day and shows the day large. A
 * talk known only to the month shows the month large and the year beside it;
 * one known only to the year shows the year. The screen reader hears the
 * date once, in words. A title in the other language carries `lang`, which
 * ListRow's string title cannot.
 *
 * The row classes mirror ListRow `date`, so every talk row looks the same.
 * Fold this back into ListRow once it takes partial dates and a title
 * language. Wrap each row in `<li>` inside `<ul role="list">`.
 */
interface Props {
  locale: Locale;
  date: PartialDate;
  title: string;
  /** Language of the title; marked when it differs from the page. */
  titleLang: Locale;
  /** "Venue · City", "Format" — one line each from md, joined by " · " on phones. */
  meta?: string[];
  /** Internal → arrow; external → ↗ and a new tab. Omit for a plain row. */
  href?: string;
  class?: string;
}

const { locale, date, title, titleLang, meta = [], href, class: className } = Astro.props;

const label = describeDate(date, locale);
const target = href ? linkKind(href) : null;
if (target === 'mail') {
  throw new Error(`A talk row cannot link to mail (${href}).`);
}
const Tag = href ? 'a' : 'div';
---

<Tag
  href={href}
  target={target === 'external' ? '_blank' : undefined}
  rel={target === 'external' ? 'noopener' : undefined}
  class={cn(
    'flex flex-col gap-2.5 border-t border-line pb-6 pt-6 text-ink md:grid md:grid-cols-[200px_minmax(0,1fr)_280px_28px] md:items-center md:gap-8 md:pb-9 md:pt-9',
    href && 'group transition-colors hover:text-sage',
    className,
  )}
>
  <time datetime={label.iso} class="flex items-baseline gap-2 md:gap-2.5">
    <span
      class="text-[40px] font-bold leading-[0.9] tracking-[-0.05em] md:text-[64px]"
      aria-hidden="true"
    >
      {label.large}
    </span>
    {label.small && (
      <span class="text-meta text-text-2 md:text-[17px]" aria-hidden="true">
        {label.small}
      </span>
    )}
    <span class="visually-hidden">{label.long}</span>
  </time>
  <span class="text-[20px] font-bold leading-[1.2] tracking-[-0.03em] md:text-h3 md:leading-[1.15]">
    <span lang={titleLang === locale ? undefined : titleLang}>{title}</span>
    {target === 'external' && (
      <span class="md:hidden" aria-hidden="true">
        {' '}
        {EXTERNAL_GLYPH}
      </span>
    )}
  </span>
  {meta.length > 0 && (
    <span class="text-[14px] leading-[1.5] text-text-2 md:text-[16px]">
      {meta.map((line, i) => (
        <>
          {i > 0 && (
            <>
              <span class="md:hidden"> · </span>
              <br class="hidden md:inline" />
            </>
          )}
          {line}
        </>
      ))}
    </span>
  )}
  {target === 'internal' && (
    <span
      class={cn(arrow, 'hidden text-[24px] leading-none md:col-start-4 md:inline-block')}
      aria-hidden="true"
    >
      →
    </span>
  )}
  {target === 'external' && (
    <>
      <span
        class="hidden text-[24px] leading-none md:col-start-4 md:inline-block"
        aria-hidden="true"
      >
        {EXTERNAL_GLYPH}
      </span>
      <span class="visually-hidden">{t(locale, 'link.newTab')}</span>
    </>
  )}
</Tag>
