---
import { getCollection } from 'astro:content';

import type { Locale } from '../../i18n/config';
import { t } from '../../i18n/ui';
import { cn } from '../../lib/cn';
import { container } from '../../lib/styles';

/**
 * The lilac band under the Home header — `band` in _Komponenten. Static, at
 * most four items. It sits in front of the portrait, which tucks behind it.
 *
 * On phones the items stack between hairlines, full bleed; from tablet they
 * share one row inside the page margin. The board's `whitespace-nowrap
 * overflow-hidden` would clip items on narrower screens and lose content, so
 * the row wraps instead. Keeping the four items
 * short enough for one line is an authoring rule, not something to enforce by
 * cutting text off.
 */
interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const MAX_ITEMS = 4;
const items = (await getCollection('news')).sort((a, b) => a.data.order - b.data.order);

if (items.length > MAX_ITEMS) {
  throw new Error(
    `src/content/data/news.yaml has ${items.length} items; the band holds at most ${MAX_ITEMS}.`,
  );
}
---

{items.length > 0 && (
  <section aria-label={t(locale, 'band.label')} class="relative z-10 bg-lilac text-ink">
    <ul
      role="list"
      class={cn(
        container,
        'flex flex-col px-0 text-[14px] font-medium tablet:flex-row tablet:flex-wrap tablet:justify-between tablet:gap-x-8 tablet:gap-y-1 tablet:px-12 tablet:py-4 tablet:text-[15px]',
      )}
    >
      {items.map((item) => (
        <li class="border-t border-ink/12 px-5 py-3 first:border-t-0 tablet:border-t-0 tablet:p-0">
          {item.data.text[locale]}
        </li>
      ))}
    </ul>
  </section>
)}
