---
import { cva, type VariantProps } from 'class-variance-authority';

import { cn } from '../../lib/cn';
import { container, splitGrid } from '../../lib/styles';

/**
 * The container of every block below the header — `section` in _Komponenten.
 *
 * Surfaces alternate paper → bone → paper. Paper paints nothing of its own, so
 * the decorative background shows through, as it does on the boards. The
 * lilac tint appears exactly once on the whole site (Talks, "Für Redaktionen").
 *
 * `split` is title + prose (5/7), `label` is label + list (3/9), `stacked` is
 * for lists and tiles. On phones every layout is one column.
 *
 * `framed` is a paper block between two hairlines, inside the page margin —
 * the study on Research (10b). Its children stack 40px apart (28 on phones)
 * and are usually `splitGrid` rows. The frame brings its own padding; the
 * space around it comes from its neighbours, as on the board, so `space` does
 * not apply.
 */
const surface = cva('', {
  variants: {
    surface: { paper: '', bone: 'bg-bone', lilac: 'bg-lilac-tint' },
  },
  defaultVariants: { surface: 'paper' },
});

const body = cva(container, {
  variants: {
    layout: {
      split: splitGrid,
      label:
        'grid gap-6 md:grid-cols-12 md:gap-12 md:[&>*:first-child]:col-span-3 md:[&>*:last-child]:col-span-9',
      stacked: 'flex flex-col',
      framed: '',
    },
    space: {
      compact: 'py-14 md:py-24',
      normal: 'py-14 md:py-28',
      read: 'py-14 md:py-32',
      /** For the few sections whose spacing the board sets by hand. */
      none: '',
    },
  },
  compoundVariants: [{ layout: 'framed', class: 'py-0 md:py-0' }],
  defaultVariants: { layout: 'split', space: 'normal' },
});

type Props = VariantProps<typeof surface> &
  VariantProps<typeof body> & {
    /** A `section` needs a heading to reference; without one this is a `div`. */
    labelledby?: string;
    class?: string;
  };

const { surface: tone, layout, space, labelledby, class: className } = Astro.props;
const Tag = labelledby ? 'section' : 'div';
---

<Tag class={surface({ surface: tone })} aria-labelledby={labelledby}>
  <div class={cn(body({ layout, space }), className)}>
    {layout === 'framed' ? (
      <div class="flex flex-col gap-7 border-y border-line py-10 md:gap-10 md:py-14">
        <slot />
      </div>
    ) : (
      <slot />
    )}
  </div>
</Tag>
