---
import { cva } from 'class-variance-authority';

import { cn } from '../../lib/cn';

/**
 * The subpage title — `ui-PageTitle` on the canvas: the page's one h1 and an
 * optional intro in the smaller lead. It brings only the type step; the grid
 * and padding around it belong to PageHeader.
 *
 * Pass the title as `title`, or as the default slot when it needs markup (the
 * Talks board breaks "Vorträge<br>& Medien"). The intro works the same way
 * through `intro` or the `intro` slot. The serif accent word is Home's alone.
 *
 * `question` is for a title that is a whole question (Research): it keeps
 * 16 characters per line from md, and drops to 36px on phones instead of 48
 * ("Frage-Titel 36" in _Komponenten, Mobile).
 */
interface Props {
  title?: string;
  intro?: string;
  size?: 'page' | 'question';
  class?: string;
}

const { title, intro, size = 'page', class: className } = Astro.props;

const h1 = cva(
  'font-bold leading-[0.98] tracking-[-0.04em] text-balance md:text-[72px] md:leading-[0.94] md:tracking-[-0.05em]',
  {
    variants: {
      size: {
        page: 'text-[48px]',
        question: 'text-[36px] md:max-w-[16ch]',
      },
    },
  },
);

const hasTitle = Boolean(title) || Astro.slots.has('default');
if (!hasTitle) {
  throw new Error('PageTitle needs a `title` or a default slot.');
}
const hasIntro = Boolean(intro) || Astro.slots.has('intro');
---

<div class={cn('flex flex-col gap-5', className)}>
  <h1 class={h1({ size })}>
    <slot>{title}</slot>
  </h1>
  {hasIntro && (
    <p class="max-w-[44ch] text-[17px] leading-[1.5] text-text-2 md:text-lead-sm">
      <slot name="intro">{intro}</slot>
    </p>
  )}
</div>
