---
import { cn } from '../../lib/cn';
import { arrow } from '../../lib/styles';

/**
 * An internal text link: sage, darkening on hover, with a trailing arrow.
 * "Button & Link" in _Komponenten — internal links never open a new tab.
 * Size comes from the parent.
 */
interface Props {
  href: string;
  class?: string;
}

const { href, class: className } = Astro.props;
---

<a
  href={href}
  class={cn(
    'group inline-flex items-center gap-2.5 font-semibold text-sage transition-colors hover:text-ink',
    className,
  )}
>
  <slot />
  <span class={arrow} aria-hidden="true">
    →
  </span>
</a>
