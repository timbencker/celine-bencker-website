---
import type { Locale } from '../../i18n/config';
import { t } from '../../i18n/ui';
import { cn } from '../../lib/cn';

/**
 * The portrait slot, 4:5 wherever it appears. Until the photo arrives it
 * renders the board's hatched placeholder; the real image will go through
 * astro:assets for responsive sizes and modern formats.
 */
interface Props {
  locale: Locale;
  class?: string;
}

const { locale, class: className } = Astro.props;
---

<div
  class={cn(
    'flex aspect-[4/5] items-center justify-center rounded-image p-3 text-center font-mono text-[11px] text-text-2 md:p-5 md:text-[12px]',
    'bg-[repeating-linear-gradient(135deg,var(--color-line)_0_10px,var(--color-bone)_10px_20px)]',
    className,
  )}
>
  {t(locale, 'portrait.pending')}
</div>
