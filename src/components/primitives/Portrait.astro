---
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';

import type { Locale } from '../../i18n/config';
import { t } from '../../i18n/ui';
import { cn } from '../../lib/cn';

/**
 * An image slot — `ui-ImagePlaceholder` until the picture exists, the picture
 * afterwards, at the same ratio so nothing moves when one replaces the other.
 *
 * - `4/5` the portrait (Home) and the press photo (Talks).
 * - `16/9` a graphic at full width on phones (the study on Research).
 * - `1/1` a square press photo.
 *
 * Without `src` it renders the board's hatched placeholder, labelled with
 * what will go there. `compact` keeps the small label at every width, for
 * small slots; by default it grows from md.
 *
 * With `src` (an imported image) it renders `<picture>` with AVIF and WebP
 * sources through astro:assets and crops to the ratio. `alt` is required:
 * describe the picture, or pass "" when the text beside it already says it.
 * Set `sizes` to the width the slot takes on the page.
 */
type Ratio = '4/5' | '16/9' | '1/1';

interface Shared {
  locale: Locale;
  ratio?: Ratio;
  class?: string;
}

interface Placeholder extends Shared {
  src?: undefined;
  /** What will go here. Defaults to "Porträt folgt" (4/5) or "Bild folgt". */
  label?: string;
  compact?: boolean;
}

interface Photo extends Shared {
  src: ImageMetadata;
  alt: string;
  /** Defaults to half the viewport from md, full width below. */
  sizes?: string;
  /** Widths to generate; anything wider than the source is dropped. */
  widths?: number[];
  /** Load early — for the one image above the fold. */
  priority?: boolean;
}

type Props = Placeholder | Photo;

const props = Astro.props;
const { locale, ratio = '4/5', class: className } = props;

const RATIO: Record<Ratio, string> = {
  '4/5': 'aspect-[4/5]',
  '16/9': 'aspect-[16/9]',
  '1/1': 'aspect-square',
};

const DEFAULT_WIDTHS = [320, 480, 640, 960, 1280];

function fittingWidths(photo: Photo): number[] {
  const fitting = (photo.widths ?? DEFAULT_WIDTHS).filter((w) => w <= photo.src.width);
  return fitting.length > 0 ? fitting : [photo.src.width];
}

const photo = props.src ? (props as Photo) : null;
const placeholder = photo ? null : (props as Placeholder);
const label =
  placeholder?.label ?? t(locale, ratio === '4/5' ? 'portrait.pending' : 'image.pending');
---

{photo ? (
  <Picture
    src={photo.src}
    alt={photo.alt}
    formats={['avif', 'webp']}
    widths={fittingWidths(photo)}
    sizes={photo.sizes ?? '(min-width: 768px) 50vw, 100vw'}
    priority={photo.priority}
    pictureAttributes={{ class: cn('block', className) }}
    class={cn('block h-auto w-full rounded-image object-cover', RATIO[ratio])}
  />
) : (
  <div
    class={cn(
      'flex',
      RATIO[ratio],
      'items-center justify-center rounded-image p-3 text-center font-mono text-[11px] text-text-2 md:p-5 md:text-[12px]',
      placeholder?.compact && 'md:p-3 md:text-[11px]',
      'bg-[repeating-linear-gradient(135deg,var(--color-line)_0_10px,var(--color-bone)_10px_20px)]',
      className,
    )}
  >
    {label}
  </div>
)}
