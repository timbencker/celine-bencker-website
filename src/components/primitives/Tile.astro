---
import { cva } from 'class-variance-authority';

import { cn } from '../../lib/cn';
import { arrow } from '../../lib/styles';

/**
 * A bone tile on paper that tints lilac on hover — `tile` in _Komponenten.
 * Tiles mean finished, comparable units; research lines, publications and
 * anything with its own page use ListRow instead.
 *
 * Only `row` is built so far (the two exits at the bottom of Home). `card`
 * arrives with Talks & Media and Contact.
 */
const tile = cva('group rounded-card bg-bone text-ink transition-colors hover:bg-lilac-tint', {
  variants: {
    kind: {
      row: 'flex items-center justify-between gap-4 px-5 py-[18px] md:gap-6 md:px-8 md:py-6',
    },
  },
  defaultVariants: { kind: 'row' },
});

interface Props {
  href: string;
  title: string;
  meta?: string;
  class?: string;
}

const { href, title, meta, class: className } = Astro.props;
---

<a href={href} class={cn(tile(), className)}>
  <span class="flex flex-col gap-[3px] md:gap-[5px]">
    <span class="text-[18px] font-bold tracking-[-0.03em] md:text-[21px]">{title}</span>
    {meta && <span class="text-[13px] text-text-3 md:text-meta">{meta}</span>}
  </span>
  <span class={cn(arrow, 'text-[20px] md:text-[22px]')} aria-hidden="true">
    →
  </span>
</a>
