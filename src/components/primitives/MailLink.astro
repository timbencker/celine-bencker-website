---
import { toHtmlEntities } from '../../lib/obfuscate';

/**
 * A mailto link whose address is written as HTML entities, so it never appears
 * in the raw HTML. No glyph and the same tab — the address is the signal
 * ("mail" in _Komponenten).
 *
 * - `subject` pre-fills the subject line, so a mail arrives already sorted
 *   (the Contact tile "Forschung & Kooperation").
 * - `label` shows text instead of the address ("Kaputter Link gefunden?"). The
 *   address stays in the link, encoded the same way.
 * - The default slot replaces the content entirely, for a whole tile that is a
 *   mail link. It wins over `label`.
 *
 * Long addresses need `break-all` on phones (_Komponenten, Mobile); pass it
 * in `class` where the address is large.
 */
interface Props {
  email: string;
  subject?: string;
  label?: string;
  class?: string;
}

const { email, subject, label, class: className = '' } = Astro.props;

// The link below is inlined as raw HTML, so refuse anything that could break
// out of an attribute. The values come from our own code and content files;
// the subject and label are encoded below, so any text is safe there.
if (/["<>]/.test(className) || /["<>\s?&]/.test(email)) {
  throw new Error(`MailLink received an unsafe value: ${JSON.stringify({ email, className })}`);
}

const target = subject
  ? `mailto:${email}?subject=${encodeURIComponent(subject)}`
  : `mailto:${email}`;
const href = toHtmlEntities(target);
const content = Astro.slots.has('default')
  ? await Astro.slots.render('default')
  : toHtmlEntities(label ?? email);
const html = `<a href="${href}" class="${className}">${content}</a>`;
---

<Fragment set:html={html} />
