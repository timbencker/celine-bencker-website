---
import { cn } from '../../lib/cn';
import { PLAIN_REGISTER_ID, plainVisible } from './register';

/**
 * "Fachlich | Einfach erklärt" — `RegisterToggle` in _Komponenten, in the
 * header's aside slot on Research. It switches the whole page (see
 * `register.ts`).
 *
 * Two native radio inputs, so the group is announced with its name and state
 * and arrow keys move between the options — no JavaScript. Each input covers
 * its pill and paints the active state itself (`toggleOption` in the spec:
 * ink with bone text), so the focus outline from global.css traces the pill.
 * Options are 44px high; the board's are 37px.
 *
 * The motto shows in the plain register only and keeps its line in both, so
 * nothing moves when the choice changes. Browsers without `:has()` cannot
 * switch the page, so the whole control stays hidden there rather than
 * offering a choice that does nothing.
 *
 * The spec also keeps the choice in the URL and localStorage; both need
 * JavaScript and are left out. A reload keeps the form state where the
 * browser restores it.
 */
interface Props {
  /** Names the radio group; shown above it. */
  label: string;
  expert: string;
  plain: string;
  motto: string;
}

const { label, expert, plain, motto } = Astro.props;
const labelId = 'register-label';

const options = [
  { value: 'expert', text: expert, id: 'register-expert', checked: true },
  { value: 'plain', text: plain, id: PLAIN_REGISTER_ID, checked: false },
];
---

<div class="hidden flex-col items-start gap-2 supports-[selector(:has(*))]:flex md:items-end md:gap-2.5">
  <span id={labelId} class="text-[13px] leading-[1.4] text-text-3 md:text-meta">
    {label}
  </span>
  <div role="radiogroup" aria-labelledby={labelId} class="inline-flex rounded-pill bg-line p-1">
    {options.map((option) => (
      <label for={option.id} class="relative inline-flex min-h-[44px] items-center">
        <input
          id={option.id}
          type="radio"
          name="register"
          value={option.value}
          checked={option.checked}
          class="peer absolute inset-0 cursor-pointer appearance-none rounded-pill transition-colors checked:bg-ink"
        />
        <span class="pointer-events-none relative px-4 text-[14px] font-semibold text-text-2 transition-colors peer-checked:text-bone peer-[:not(:checked):hover]:text-ink">
          {option.text}
        </span>
      </label>
    ))}
  </div>
  <p
    class={cn(
      'min-h-[20px] text-[13px] italic leading-[1.5] text-text-3 md:min-h-[21px] md:text-[14px]',
      plainVisible,
    )}
  >
    {motto}
  </p>
</div>
